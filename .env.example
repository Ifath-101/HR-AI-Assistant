# Google Gemini API Configuration
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Port Configuration
FRONTEND_PORT=3001
BACKEND_PORT=8001

# Security / JWT Authentication
JWT_SECRET=peoplesphere-dev-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Demo Credentials (Seeded on first startup)
ADMIN_PASSWORD=Admin@123
EMPLOYEE_PASSWORD=Employee@123

# Storage Paths
DATABASE_PATH=./data/hr.db
CHROMA_PERSIST_DIRECTORY=./chroma_data
UPLOAD_DIRECTORY=./uploads

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173
